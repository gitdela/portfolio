# Dependencies
node_modules/
.pnp.*

# Build output
# next-env.d.ts is generated, and its contents differ depending on whether `next dev` or
# `next build` ran last (.next/dev/types vs .next/types), so tracking it means a dirty tree
# every time you switch. Typecheck passes without it.
next-env.d.ts
.next/
out/
dist/
build/
*.tsbuildinfo

# Caches
.turbo/
.cache/
.eslintcache
.sanity/

# Test and audit output
coverage/
playwright-report/
playwright/.cache/
test-results/
.lighthouseci/

# Environment — real values never enter version control
.env
.env.*
!.env.example

# Platform
.vercel/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
