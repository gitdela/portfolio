# Copy to .env.local and fill in. No real credentials belong in this file.

SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"

# Origin the Presentation tool loads in its preview pane.
# Local development: http://localhost:3000
SANITY_STUDIO_PREVIEW_URL="http://localhost:3000"

# Set once `sanity deploy` has run for the first time; pins the deployed Studio's identity.
SANITY_STUDIO_APP_ID=""

# CI only — a scoped deploy token. Never commit a real value.
# SANITY_AUTH_TOKEN=""
