# Copy to .env.local and fill in. No real credentials belong in this file.

# ---------------------------------------------------------------- public
# Inlined into the client bundle. Nothing secret goes here.

# Canonical origin. The canonical URL is always derived from this, never from an
# incidental Vercel preview URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-08-01"

# Used to link editors from the site back into the Studio.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# ---------------------------------------------------------------- server
# Never exposed to the browser.

# Viewer-scoped token used for Draft Mode previews only.
SANITY_API_READ_TOKEN=""

# Shared secret for the signed Sanity webhook at POST /api/revalidate/sanity.
SANITY_REVALIDATE_SECRET=""

TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

RESEND_API_KEY=""

# Must be on a verified send.<production-domain> subdomain.
RESEND_FROM_EMAIL="contact@send.example.com"

# Where contact submissions are delivered. Content, not configuration, stays out of Sanity.
CONTACT_TO_EMAIL="you@example.com"
