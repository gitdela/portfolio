{
  "extends": "@portfolio/typescript-config/nextjs.json",
  "compilerOptions": {
    // No `baseUrl`: it is deprecated in TypeScript 6, and `paths` already resolves
    // relative to this file's directory.
    "paths": {
      "@/*": ["./src/*"]
    },
    // "bun" supplies the `bun:test` module types for the co-located unit tests.
    "types": ["node", "bun"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
