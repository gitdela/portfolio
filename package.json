{
  "name": "portfolio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@sanity/client": "^7.26.2",
      "@types/node": "^26.2.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "eslint": "^10.8.1",
      "prettier": "^3.9.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sanity": "^6.10.1",
      "turbo": "^2.10.11",
      "typescript": "6.0.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "deploy": "turbo run deploy",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "catalog:"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  }
}
