{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@portfolio/typescript-config/nextjs",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "preserve",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "incremental": true,

    "plugins": [{ "name": "next" }],
    "noEmit": true
  }
}
