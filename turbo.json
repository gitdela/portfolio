{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "envMode": "strict",
  "globalDependencies": ["bunfig.toml", ".prettierrc.json"],
  "globalEnv": ["CI", "NODE_ENV"],
  "globalPassThroughEnv": [
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_GIT_COMMIT_SHA",
    "TURBO_TEAM",
    "TURBO_TOKEN"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "!dist/.turbo/**"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "test": {
      "dependsOn": ["topo"],
      "outputs": ["coverage/**"]
    },
    "typegen": {
      "cache": false
    },
    "deploy": {
      "dependsOn": ["build", "lint", "typecheck", "test"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
